# ==========================================
# PlateProof 360 - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
# Option 1: Full connection string
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plateproof360
# Option 2: Discrete connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=plateproof360
DB_SSL=false
DB_POOL_MAX=20

# JWT & Authentication (for future phases)
JWT_SECRET=replace_with_a_long_random_secret_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# QR Code Token Signing Secret
QR_SIGNING_SECRET=replace_with_a_secure_token_secret_for_signed_qrs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Client Configuration (used by Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
